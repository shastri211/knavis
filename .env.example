# Copy to .env and fill in only the providers you want. Never commit .env.
# Each setting must appear ONCE: with duplicates the last one silently wins.

HOST=127.0.0.1
PORT=8000
# Origins allowed to call the API from a browser (comma separated). Not needed with Docker (same origin through nginx).
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Where the database, uploads and page renders live.
# Relative paths resolve against the project root. Default: backend/data
# DATA_DIR=backend/data

# Chat providers (the model must be in backend/app/providers.py CATALOG, or set OPENROUTER_MODEL)
NVIDIA_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
DEFAULT_PROVIDER=groq
DEFAULT_MODEL=openai/gpt-oss-20b

NVIDIA_OCR_BASE_URL=https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-ocr-v2

# Audio transcription
ASSEMBLYAI_API_KEY=

# Dense retrieval (optional; without NVIDIA_API_KEY the app answers from keyword search only)
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_DIMENSIONS=2048
# Leave QDRANT_URL empty to use local on-disk Qdrant under DATA_DIR
QDRANT_URL=
QDRANT_API_KEY=
# One collection shared by every session (a session_id filter keeps them apart). Default: knavis_chunks
QDRANT_COLLECTION=

# Spreadsheet analytics: aggregation questions are answered with a validated read-only SQL query over the sheet.
ANALYTICS_ENABLED=true
ANALYTICS_TIMEOUT_SECONDS=5
ANALYTICS_MAX_ROWS=200

# ---- Accounts and abuse protection ---------------------------------------------------------
# AUTH_ENABLED=false makes the app single-user and open (local use only). With accounts on, the first person to
# register also takes ownership of any chats created before accounts existed.
AUTH_ENABLED=true
ALLOW_REGISTRATION=true          # set to false once everyone who needs an account has one
TOKEN_TTL_DAYS=30
# Requests per minute per signed-in user (per client address for sign-in). 0 turns a limit off.
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=12
RATE_LIMIT_AUTH_PER_MINUTE=10
# Only behind a reverse proxy you control (the Docker setup does this): read the client address from X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Upload safety: a small file can describe a huge one, so archives, PDFs and images are checked before parsing.
MAX_ARCHIVE_ENTRIES=5000
MAX_UNPACKED_MB=500
MAX_PDF_PAGES=1000
MAX_IMAGE_MEGAPIXELS=100
MAX_DOCUMENTS_PER_SESSION=50
MAX_USER_STORAGE_MB=1000

# ---- Docker (docker-compose.yml) -------------------------------------------------------------
# KNAVIS_BIND=127.0.0.1          # use 0.0.0.0 only behind HTTPS you control
# KNAVIS_PORT=8080

# Limits
MAX_UPLOAD_MB=50
MAX_MESSAGE_CHARS=20000
MAX_AGENT_RETRIEVAL_CALLS=2
TOP_K_RERANK=12

# Evidence gate: a chunk is usable if dense cosine >= EVIDENCE_MIN_DENSE
# OR it covers >= EVIDENCE_MIN_COVERAGE of the question's content terms.
EVIDENCE_MIN_DENSE=0.35
EVIDENCE_MIN_COVERAGE=0.5
EVIDENCE_MAX_ITEMS=8

# ---- Hosted specialists (OCR, figure descriptions, speech-to-text) -----------------------------
# Each *_PROVIDER is "auto" (first configured provider), a provider name, or "none".
MISTRAL_API_KEY=
OCR_PROVIDER=auto                 # mistral (preferred when its key is set) | nvidia
VISION_PROVIDER=auto              # groq | gemini
VISION_MODEL=qwen/qwen3.8-27b     # Groq vision model id; model catalogs change, run scripts/check_config.py --online
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash-lite
ASR_PROVIDER=auto                 # groq (files up to 25 MB) | assemblyai
ASR_MODEL=whisper-large-v3-turbo

# Gemini's free tier uses submitted content to improve Google's products. Gemini is never used for your
# documents unless you set this to true.
ALLOW_FREE_TIER_DATA_USE=false

# A document needing more than this many hosted calls (OCR pages + figure descriptions + transcription)
# waits for confirmation instead of spending free-tier quota.
CONFIRM_ABOVE_CALLS=25
VISION_MAX_FIGURES_PER_DOC=8

# The built-in quota limits are conservative placeholders. Set your account's real limits (JSON), e.g.
# QUOTA_OVERRIDES={"mistral_ocr":{"pages":{"minute":60,"day":2000}},"groq_chat":{"requests":{"minute":30,"day":14400}}}
