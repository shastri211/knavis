# Copy to .env and fill in only the providers you want. Never commit .env.
# Each setting must appear ONCE: with duplicates the last one silently wins.

HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Where the database, uploads and page renders live.
# Relative paths resolve against the project root. Default: backend/data
# DATA_DIR=backend/data

# Chat providers (the model must be in backend/app/providers.py CATALOG, or set OPENROUTER_MODEL)
NVIDIA_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
DEFAULT_PROVIDER=nvidia
DEFAULT_MODEL=meta/llama-3.1-8b-instruct

# Audio transcription
ASSEMBLYAI_API_KEY=

# Dense retrieval (optional; without NVIDIA_API_KEY the app uses lexical BM25 only)
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
EMBEDDING_DIMENSIONS=1024
# Leave QDRANT_URL empty to use local on-disk Qdrant under DATA_DIR
QDRANT_URL=
QDRANT_API_KEY=

# Limits
MAX_UPLOAD_MB=50
MAX_MESSAGE_CHARS=20000
MAX_AGENT_RETRIEVAL_CALLS=2
TOP_K_RERANK=12

# Evidence gate: a chunk is usable if dense cosine >= EVIDENCE_MIN_DENSE
# OR it covers >= EVIDENCE_MIN_COVERAGE of the question's content terms.
EVIDENCE_MIN_DENSE=0.35
EVIDENCE_MIN_COVERAGE=0.5
EVIDENCE_MAX_ITEMS=8
